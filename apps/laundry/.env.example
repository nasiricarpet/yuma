# -----------------------------------------------------------------------------
# تنظیمات محیطی پنل خشکشویی یوما — نسخه نمونه
# این فایل را به .env.local کپی کرده و مقادیر را برای سرور خود پر کنید
# -----------------------------------------------------------------------------

# آدرس پایه API — در سرور ایران IP سرور را جایگزین کنید
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:3001/api

# آدرس خود این پنل
NEXT_PUBLIC_APP_URL=http://YOUR_SERVER_IP:3003

# نام نمایشی اپلیکیشن
NEXT_PUBLIC_APP_NAME=پنل خشکشویی یوما

# زبان و جهت پیش‌فرض (پیش‌فرض: fa-IR / rtl)
NEXT_PUBLIC_APP_LOCALE=fa-IR

# غیرفعال کردن تله‌متری Next.js در محیط توسعه
NEXT_TELEMETRY_DISABLED=1
