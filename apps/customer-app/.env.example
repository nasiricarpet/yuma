# آدرس پایه API بک‌اند یوما
# در Expo فقط متغیرهای با پیشوند EXPO_PUBLIC_ در کد کلاینت در دسترس هستند
# بک‌اند به‌صورت پیش‌فرض روی پورت ۳۰۱ اجرا می‌شود (apps/api/src/main.ts)
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# قالیشویی پیش‌فرض برای ثبت سفارش (UUID ثابتِ seed شده در دیتابیس محلی)
# TODO: در فاز بعدی این مقدار از endpoint کاتالوگ قالیشویی‌ها خوانده شود
EXPO_PUBLIC_DEFAULT_LAUNDRY_ID=00000000-0000-4000-8000-000000000001
