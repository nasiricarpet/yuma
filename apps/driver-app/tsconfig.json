{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"],
      "@yuma/persian": ["../../packages/persian/src/index.ts"],
      "@yuma/validators": ["../../packages/validators/src/index.ts"],
      "@yuma/types": ["../../packages/types/src/index.ts"],
      "@yuma/config": ["../../packages/config/src/index.ts"],
      "@yuma/ui": ["../../packages/ui/src/index.ts"],
      "@yuma/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  "exclude": ["node_modules"]
}
