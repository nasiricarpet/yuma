# -----------------------------------------------------------------------------
# تنظیمات محیطی اپ سفیر یوما — نسخه نمونه
# در Expo فقط متغیرهای با پیشوند EXPO_PUBLIC_ در کد سمت کلاینت در دسترس هستند.
# این فایل را به .env کپی کرده و مقادیر را برای سرور خود پر کنید.
# -----------------------------------------------------------------------------

# آدرس پایه API بک‌اند یوما ( NestJS روی پورت ۳۰۰۱ )
# در سرور ایران IP سرور را جایگزین کنید
EXPO_PUBLIC_API_URL=http://YOUR_SERVER_IP:3001/api

# قالیشویی پیش‌فرض (UUID ثابتِ seed شده در دیتابیس محلی)
EXPO_PUBLIC_DEFAULT_LAUNDRY_ID=00000000-0000-4000-8000-000000000001
