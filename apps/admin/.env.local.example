# -----------------------------------------------------------------------------
# تنظیمات محیطی پنل ادمین یوما
# این فایل را به .env.local کپی کرده و مقادیر را پر کنید
# -----------------------------------------------------------------------------

# آدرس پایه API — نسخه محلی
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# آدرس خود این پنل (برای redirectهای OAuth و متادیتا)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# نام نمایشی اپلیکیشن
NEXT_PUBLIC_APP_NAME=پنل ادمین یوما

# زبان و جهت پیش‌فرض (پیش‌فرض: fa-IR / rtl)
NEXT_PUBLIC_APP_LOCALE=fa-IR

# غیرفعال کردن تله‌متری Next.js در محیط توسعه
NEXT_TELEMETRY_DISABLED=1
