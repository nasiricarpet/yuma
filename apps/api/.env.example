# ---- سرور ----
NODE_ENV=development
PORT=3001

# ---- دیتابیس (هم‌راستا با docker-compose.yml) ----
DATABASE_URL="postgresql://yuma:yuma@localhost:5432/yuma?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- احراز هویت ----
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ---- ایمیل (Mailhog در محیط توسعه) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="یوما <no-reply@yuma.ir>"

# ---- ذخیره‌سازی ابری (MinIO در docker-compose) ----
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="yuma-media"
S3_REGION="us-east-1"

# ---- پروکسی (در صورت نیاز محیط شرکتی) ----
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,.local
