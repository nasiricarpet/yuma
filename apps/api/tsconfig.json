{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "paths": {
      "@yuma/persian": ["../../packages/persian/src/index.ts"],
      "@yuma/validators": ["../../packages/validators/src/index.ts"],
      "@yuma/types": ["../../packages/types/src/index.ts"],
      "@yuma/config": ["../../packages/config/src/index.ts"],
      "@yuma/db": ["../../packages/db/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
