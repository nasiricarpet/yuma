{
  "name": "@yuma/api",
  "version": "0.1.0",
  "description": "API نست‌جی‌اس پروژه YUMA",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "jest",
    "test:e2e": "jest --config jest-e2e.json",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.3.0",
    "@types/bcrypt": "^6.0.0",
    "@yuma/config": "workspace:*",
    "@yuma/db": "workspace:*",
    "@yuma/persian": "workspace:*",
    "@yuma/types": "workspace:*",
    "@yuma/validators": "workspace:*",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@yuma/persian$": "<rootDir>/../../../packages/persian/src/index.ts",
      "^@yuma/validators$": "<rootDir>/../../../packages/validators/src/index.ts",
      "^@yuma/types$": "<rootDir>/../../../packages/types/src/index.ts",
      "^@yuma/config$": "<rootDir>/../../../packages/config/src/index.ts",
      "^@yuma/db$": "<rootDir>/../../../packages/db/src/index.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!.*@nestjs/(event-emitter|bullmq|bull-shared|passport))"
    ],
    "testEnvironment": "node"
  }
}
