// YUMA — اسکیمای اولیه Prisma
// PostgreSQL 16 — ذخیره مبلغ به ریال (IRR)، نمایش به تومان

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// نقش‌های کاربری — RBAC؛ باید با `USER_ROLES` در @yuma/types همگان بماند
enum UserRole {
  admin
  manager
  expert
  support
  finance
  laundry_manager
  laundry_user
  driver
  customer
}

enum OrderStatus {
  // جریان فعلی — ثبت تا بسته‌شدن
  requested
  awaiting_confirmation
  awaiting_pickup
  picked_up
  awaiting_assessment
  quoted
  quote_approved
  in_cleaning
  quality_control
  ready_for_delivery
  out_for_delivery
  delivered
  closed
  cancelled
  // جریان قدیمی — ماژول‌های pricing/payments/assignments هنوز از این مقادیر استفاده می‌کنند
  pending
  assigned
  at_laundry
  quotation_sent
  quotation_approved
  washing
  quality_check
  ready
}

enum VehicleType {
  motorcycle
  car
  van
}

/// حساب‌های دفتر کل — مدل دوطرفه‌ی مالی پلتفرم
enum LedgerAccount {
  /// بدهی مشتری به پلتفرم
  customer_receivable
  /// حساب ترانزیت درگاه پرداخت — تا زمان تسویه با بانک
  gateway_clearing
  /// درآمد کارمزد پلتفرم
  platform_revenue
  /// بدهی پلتفرم به کارگاه
  workshop_payable
  /// مالیات بر ارزش افزوده‌ی قابل پرداخت به سازمان امور مالیاتی
  tax_payable
}

enum LedgerDirection {
  debit
  credit
}

/// وضعیت تسویه‌ی دوره‌ای کارگاه
enum SettlementStatus {
  pending
  paid
}

/// دسته‌بندی تیکت پشتیبانی
enum TicketCategory {
  order_issue
  payment_issue
  delivery_issue
  quality_issue
  account_issue
  other
}

/// اولویت تیکت — تعیین‌کننده‌ی مهلت پاسخ اولیه (SLA)
enum TicketPriority {
  low
  medium
  high
  urgent
}

/// وضعیت تیکت پشتیبانی
enum TicketStatus {
  /// باز — در انتظار پاسخ پشتیبان
  open
  /// در حال پیگیری — پشتیبان در حال رسیدگی است
  pending_agent
  /// حل‌شده — مشتری تأیید نکرده است
  resolved
  /// بسته‌شده
  closed
}

/// دیدمندی پیام تیکت — پیام داخلی برای مشتری قابل مشاهده نیست
enum MessageVisibility {
  public
  internal
}

model User {
  id           String    @id @default(uuid())
  mobile       String    @unique // فرمت نرمال: 09xxxxxxxxx
  fullName     String
  email        String?   @unique
  nationalCode String?   @unique
  passwordHash String
  role         UserRole  @default(customer)
  isActive     Boolean   @default(true)
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ownedLaundries Laundry[]       @relation("LaundryOwner")
  driverProfile  Driver?
  customerOrders Order[]         @relation("CustomerOrders")
  refreshTokens  RefreshToken[]
  addresses      UserAddress[]
  updatedSettings Setting[]      @relation("SettingUpdatedBy")
  auditLogs      AuditLog[]      @relation("AuditActor")
  notifications  Notification[] @relation("UserNotifications")
  supportTickets  SupportTicket[] @relation("CustomerTickets")
  assignedTickets SupportTicket[] @relation("AgentTickets")
  ticketMessages  SupportMessage[] @relation("TicketMessages")

  @@map("users")
}

model UserAddress {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  province    String
  city        String
  fullAddress String   @map("full_address")
  postalCode  String   @map("postal_code")
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)
  isDefault   Boolean  @default(false) @map("is_default")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Laundry {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @map("owner_id")
  city      String
  address   String
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner       User        @relation("LaundryOwner", fields: [ownerId], references: [id])
  orders      Order[]
  services    LaundryService[]
  settlements WorkshopSettlement[]

  @@map("laundries")
}

model LaundryService {
  id         String  @id @default(uuid())
  laundryId  String  @map("laundry_id")
  name       String
  /** قیمت واحد به ریال */
  unitPrice  Int     @map("unit_price")
  /** واحد شمارش: عدد، متر مربع، کیلوگرم */
  unit       String  @default("count")
  isActive   Boolean @default(true) @map("is_active")

  laundry     Laundry     @relation(fields: [laundryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([laundryId])
  @@map("laundry_services")
}

model Driver {
  id          String      @id @default(uuid())
  userId      String      @unique @map("user_id")
  vehicleType VehicleType @default(motorcycle) @map("vehicle_type")
  plateNumber String?     @map("plate_number")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")

  user            User                @relation(fields: [userId], references: [id])
  assignedOrders  Order[]             @relation("DriverOrders")
  driverLocations DriverLocationLog[]
  assignments     Assignment[]

  @@map("drivers")
}

model DriverLocationLog {
  id        String   @id @default(uuid())
  driverId  String   @map("driver_id")
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  createdAt DateTime @default(now()) @map("created_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
  @@map("driver_location_logs")
}

model Order {
  id           String      @id @default(uuid())
  trackingCode    String      @unique @map("tracking_code") // کد پیگیری YUMA-XXXXXX
  /** کلید یکتای جلوگیری از ثبت تکراری سفارش (idempotency) */
  idempotencyKey  String?     @unique @map("idempotency_key")
  customerId      String      @map("customer_id")
  laundryId       String?     @map("laundry_id")
  driverId        String?     @map("driver_id")
  status          OrderStatus @default(requested)

  // آدرس برداشت (اجباری)
  province    String
  city        String
  postalCode  String  @map("postal_code")
  fullAddress String  @map("full_address")
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  // آدرس تحویل (اختیاری — خالی باشد یعنی تحویل در آدرس برداخت)
  deliveryProvince    String? @map("delivery_province")
  deliveryCity        String? @map("delivery_city")
  deliveryPostalCode  String?  @map("delivery_postal_code")
  deliveryFullAddress String? @map("delivery_full_address")
  deliveryLatitude    Decimal? @map("delivery_latitude") @db.Decimal(9, 6)
  deliveryLongitude   Decimal? @map("delivery_longitude") @db.Decimal(9, 6)

  /** جمع کل به ریال */
  totalAmount       Int    @default(0) @map("total_amount")
  currency          String @default("IRR")
  description       String?
  pickupTimeSlot    String? @map("pickup_time_slot")
  deliveryTimeSlot  String? @map("delivery_time_slot")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer   User            @relation("CustomerOrders", fields: [customerId], references: [id])
  laundry    Laundry?        @relation(fields: [laundryId], references: [id])
  driver     Driver?         @relation("DriverOrders", fields: [driverId], references: [id])
  items      OrderItem[]
  statusHistory OrderStatusHistory[]
  assignments   Assignment[]
  media         OrderMedia[]
  quotation     Quotation?
  payments      Payment[]
  notifications Notification[] @relation("OrderNotifications")
  ledgerEntries LedgerEntry[]
  supportTickets SupportTicket[]

  @@index([customerId])
  @@index([laundryId, status])
  @@index([driverId, status])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  serviceId String @map("service_id")
  quantity  Int    @default(1)
  areaSqm   Decimal? @map("area_sqm") @db.Decimal(8, 2)
  /** قیمت واحد در لحظه سفارش (ریال) */
  unitPrice Int    @map("unit_price")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service LaundryService @relation(fields: [serviceId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  note      String?
  actorId   String?     @map("actor_id")
  /** نقش کاربری که این تغییر وضعیت را انجام داده است */
  actorRole String?     @map("actor_role")
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderMedia {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  fileUrl   String   @map("file_url")
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_media")
}

model Assignment {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  driverId  String   @map("driver_id")
  phase     String   // pickup | delivery
  status    String   @default("pending") // pending | accepted | done | failed
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId, status])
  @@map("assignments")
}

model Quotation {
  id             String    @id @default(uuid())
  orderId        String    @unique @map("order_id")
  subtotalAmount Int       @map("subtotal_amount")
  deliveryFee    Int       @default(0) @map("delivery_fee")
  taxAmount      Int       @default(0) @map("tax_amount")
  totalAmount    Int       @map("total_amount")
  status         String    @default("draft") // draft | sent | approved | rejected
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("quotations")
}

model AuditLog {
  id         String   @id @default(cuid())
  /** شناسه کاربری که عمل را انجام داده — برای رویدادهای سیستمی NULL است */
  actorId    String?  @map("actor_id")
  /** نقش کاربر در لحظه‌ی انجام عمل — برای انطباق با داده‌ی تاریخی رشته‌ی ساده است */
  actorRole  String?  @map("actor_role")
  /** نوع عمل: create | update | delete | login | logout */
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  /** وضعیت موجودیت پیش از تغییر */
  before     Json?
  /** وضعیت موجودیت پس از تغییر */
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  /** شناسه‌ی یکتای درخواست — برای ردیابی یک زنجیره‌ی کامل در لاگ‌ها */
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(uuid())
  /** کلید یکتای تنظیم — مثلاً brand.primaryColor */
  key         String   @unique
  /** مقدار تنظیم — هر نوع JSON معتبر */
  value       Json
  /** دسته‌بندی: brand, contact, payment, order, sms, features */
  category    String
  /** آیا این تنظیم برای کاربران عمومی قابل مشاهده است؟ */
  isPublic    Boolean  @default(false) @map("is_public")
  /** کاربری که آخرین بار این تنظیم را تغییر داده */
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isPublic])
  @@map("settings")
}

model Payment {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  customerId  String   @map("customer_id")
  amount      Int
  authority   String?  @unique
  referenceId String?  @map("reference_id")
  status      String   @default("pending") // pending | success | failed
  method      String   @default("online")
  createdAt   DateTime @default(now()) @map("created_at")

  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@index([orderId])
  @@map("payments")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  /** کد قالب — مثلاً order_requested */
  code      String   @unique
  /** کانال ارسال: sms | email */
  channel   String
  /** زبان قالب — فعلاً فقط fa */
  locale    String   @default("fa")
  /** نسخه‌ی قالب — امکان نگه‌داری چند نسخه از یک قالب */
  version   Int      @default(1)
  /** موضوع پیام — برای ایمیل؛ پیامک موضوع ندارد */
  subject   String?
  /** متن قالب با متغیرهای {{name}} */
  body      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([code, channel, locale, version])
  @@map("notification_templates")
}

model Notification {
  id           String    @id @default(uuid())
  userId       String?   @map("user_id")
  orderId      String?   @map("order_id")
  /** کانال ارسال: sms | email */
  channel      String
  /** کد قالب استفاده‌شده */
  templateCode String    @map("template_code")
  /** گیرنده: موبایل یا ایمیل */
  recipient    String
  /** متغیرهای جایگزین‌شده در قالب */
  payload      Json
  /** queued | sent | failed */
  status       String    @default("queued")
  /** مرجع پروایدر — مثلاً شناسه پیامک کاونگر */
  providerRef  String?   @map("provider_ref")
  errorMessage String?   @map("error_message")
  attempts     Int       @default(0)
  sentAt       DateTime? @map("sent_at")
  deliveredAt  DateTime? @map("delivered_at")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user  User?   @relation("UserNotifications", fields: [userId], references: [id], onDelete: SetNull)
  order Order?  @relation("OrderNotifications", fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model LedgerEntry {
  /// شناسه‌ی عددی بزرگ — ترتیب ثبت قطعی را تضمین می‌کند
  id          BigInt          @id @default(autoincrement())
  /// گروه ثبت — همه‌ی قلم‌های یک رویداد مالی یک گروه را اشتراک می‌زنند
  entryGroup  String          @map("entry_group")
  orderId     String?         @map("order_id")
  paymentId   String?         @map("payment_id")
  account     LedgerAccount
  direction   LedgerDirection
  /// مبلغ به ریال — واحد خردی مالی
  amountMinor BigInt          @map("amount_minor")
  currency    String          @default("IRR")
  /** مرجع پرداخت/تسویه — کد رهگیری درگاه یا شناسه‌ی تسویه */
  reference   String?
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([entryGroup])
  @@index([orderId])
  @@index([paymentId])
  @@index([account, createdAt])
  @@map("ledger_entries")
}

model WorkshopSettlement {
  id              String           @id @default(uuid())
  workshopId      String           @map("workshop_id")
  /** شروع دوره — اولین روز ماه میلادی (YYYY-MM) */
  periodStart     DateTime         @map("period_start")
  /** پایان دوره — انحصاری (اولین روز ماه بعد) */
  periodEnd       DateTime         @map("period_end")
  /** جمع کل پرداخت‌های کارگاه در دوره (ریال) */
  grossMinor      BigInt           @map("gross_minor")
  /** کارمزد پلتفرم در دوره (ریال) */
  commissionMinor BigInt           @map("commission_minor")
  /** مبلغ خالص قابل پرداخت به کارگاه (ریال) */
  netPayableMinor BigInt           @map("net_payable_minor")
  status          SettlementStatus @default(pending)
  paidAt          DateTime?        @map("paid_at")
  /** مرجع پرداخت بانکی تسویه — مثلاً شناسه‌ی حواله */
  reference       String?
  createdAt       DateTime         @default(now()) @map("created_at")

  workshop Laundry @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  /** یک کارگاه در هر دوره فقط یک تسویه دارد */
  @@unique([workshopId, periodStart, periodEnd])
  @@index([status, periodStart])
  @@map("workshop_settlements")
}

model SupportTicket {
  id          String         @id @default(uuid())
  /** سفارش مرتبط — اختیاری؛ تیکت‌های عمومی سفارش ندارند */
  orderId     String?        @map("order_id")
  customerId  String         @map("customer_id")
  category    TicketCategory
  priority    TicketPriority @default(medium)
  status      TicketStatus   @default(open)
  subject     String
  /** پشتیبان مسئول رسیدگی — خالی یعنی تخصیص نیافته */
  assignedToId String?       @map("assigned_to_id")
  /** مهلت پاسخ اولیه — نقض آن از طریق SLAJob هشدار داده می‌شود */
  slaDueAt    DateTime?      @map("sla_due_at")
  firstResponseAt DateTime?  @map("first_response_at")
  resolvedAt  DateTime?      @map("resolved_at")
  /** امتیاز رضایت مشتری — ۱ تا ۵، پس از حل ثبت می‌شود */
  satisfaction Int?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  order      Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer   User            @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo User?           @relation("AgentTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]

  @@index([customerId, createdAt])
  @@index([assignedToId, status])
  @@index([status, priority])
  @@index([slaDueAt])
  @@map("support_tickets")
}

model SupportMessage {
  /// شناسه‌ی عددی بزرگ — ترتیب پیام‌ها در یک تیکت را تضمین می‌کند
  id           BigInt            @id @default(autoincrement())
  ticketId     String            @map("ticket_id")
  /** فرستنده — برای پیام‌های سیستمی NULL است */
  senderUserId String?           @map("sender_user_id")
  visibility   MessageVisibility @default(public)
  body         String
  createdAt    DateTime          @default(now()) @map("created_at")

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser User?         @relation("TicketMessages", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
