{
  "name": "@yuma/config",
  "version": "0.1.0",
  "description": "کانفیگ‌های مشترک: eslint، tsconfig، constants (locale، timezone، currency)",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./eslint-base": "./eslint-base.mjs",
    "./tsconfig": "./tsconfig.json",
    "./tailwind/nextjs": {
      "types": "./dist/tailwind/nextjs.d.ts",
      "import": "./dist/tailwind/nextjs.mjs",
      "require": "./dist/tailwind/nextjs.js"
    }
  },
  "files": ["dist", "eslint-base.mjs", "tsconfig.json"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
